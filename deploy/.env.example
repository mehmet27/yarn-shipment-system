# Yerel geliştirme ayarları. Bu dosyayı deploy/.env olarak kopyalayıp değerleri değiştirin.
# deploy/.env git'e girmez (SEC-14).

# PostgreSQL süper kullanıcısının şifresi (yalnızca yerel kurulum için)
POSTGRES_PASSWORD=change-me-superuser

# Tek veritabanı kullanıcısının (yarnshipment) yerel şifresi; servisler DB_PASSWORD olarak bu değeri alır.
LOCAL_DB_PASSWORD=change-me-local

# Yerel örnek kullanıcıların (admin, depo, kalite, mudur) ortak şifresi; yarnshipment-app LOCAL_TEST_USER_PASSWORD olarak okur.
# En az 8 karakter olmalı; yaygın şifreler (ör. 12345678) reddedilir.
LOCAL_TEST_USER_PASSWORD=change-me-test-users

# Kanıt dosyası yükleme/indirme adreslerini imzalayan anahtar (en az 32 karakter); yarnshipment-app
# EVIDENCE_STORAGE_SIGNING_KEY olarak okur. Dosyalar EVIDENCE_STORAGE_ROOT klasörüne yazılır (varsayılan ./data/evidence).
EVIDENCE_STORAGE_SIGNING_KEY=change-me-evidence-signing-key-0123456789
