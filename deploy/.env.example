# Yerel geliştirme ayarları. Bu dosyayı deploy/.env olarak kopyalayıp değerleri değiştirin.
# deploy/.env git'e girmez (SEC-14).

# PostgreSQL süper kullanıcısının şifresi (yalnızca yerel kurulum için)
POSTGRES_PASSWORD=change-me-superuser

# Servis rollerinin (<servis>_migrator, <servis>_app, <servis>_readonly) yerel şifresi
LOCAL_DB_PASSWORD=change-me-local

# Keycloak yönetici konsolu (http://localhost:8180) için yerel şifre
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Yerel test kullanıcılarının (admin, depo, kalite, mudur, sofor, fasoncu) ortak şifresi
KEYCLOAK_TEST_USER_PASSWORD=change-me-test-users

# Gateway'in Keycloak'taki istemci sırrı
GATEWAY_CLIENT_SECRET=change-me-gateway-secret

# shipment-service'in Keycloak'ta giriş hesabı açan servis hesabı istemcisinin sırrı (isteğe bağlı; yoksa yerel varsayılan kullanılır).
# shipment-service'i başlatırken aynı değer YARNSHIPMENT_KEYCLOAK_ADMIN_CLIENT_SECRET olarak verilir; verilmezse
# "Giriş hesabı aç" 502 LOGIN_ACCOUNT_UNAVAILABLE döner.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-client

# Gateway oturumlarını tutan Redis'in şifresi; gateway'i başlatırken aynı değer REDIS_PASSWORD olarak verilir.
REDIS_PASSWORD=change-me-redis

# Kanıt dosyalarının tutulduğu MinIO'nun yönetici anahtarları; evidence-service aynı değerleri
# EVIDENCE_STORAGE_ACCESS_KEY / EVIDENCE_STORAGE_SECRET_KEY olarak alır.
EVIDENCE_STORAGE_ACCESS_KEY=change-me-minio-user
EVIDENCE_STORAGE_SECRET_KEY=change-me-minio-secret
