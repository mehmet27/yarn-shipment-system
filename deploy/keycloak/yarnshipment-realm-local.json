          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "audience-yarnshipment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "yarnshipment-api"
          }
        },
        {
          "name": "subcontractor_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "subcontractor_id",
            "claim.name": "subcontractor_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "driver_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "driver_id",
            "claim.name": "driver_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "site_ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "site_ids",
            "claim.name": "site_ids",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "yarnshipment-admin",
      "name": "Hesap yönetimi (servis hesabı)",
      "description": "shipment-service'in şoför/fasoncu giriş hesabı açması için; yalnızca kullanıcı yönetimi yetkisi vardır.",
      "enabled": true,
