{
  "realm": "yarnshipment",
  "displayName": "İplik Sevkiyat (yerel geliştirme)",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "defaultLocale": "tr",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Rol: admin"
      },
      {
        "name": "warehouse",
        "description": "Rol: warehouse"
      },
      {
        "name": "driver",
        "description": "Rol: driver"
      },
      {
        "name": "subcontractor",
        "description": "Rol: subcontractor"
      },
      {
        "name": "quality",
        "description": "Rol: quality"
      },
      {
        "name": "manager",
        "description": "Rol: manager"
      },
      {
        "name": "system",
        "description": "Rol: system"
      }
    ]
  },
  "clients": [
    {
      "clientId": "yarnshipment-api",
      "name": "Servis API'leri",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "yarnshipment-gateway",
      "name": "Gateway (BFF)",
      "enabled": true,
      "publicClient": false,
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "audience-yarnshipment-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "yarnshipment-api"
          }
        },
        {
          "name": "subcontractor_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "subcontractor_id",
            "claim.name": "subcontractor_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "driver_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "driver_id",
            "claim.name": "driver_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "site_ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "site_ids",
            "claim.name": "site_ids",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "yarnshipment-dev-tools",
      "name": "Yalnızca yerel doğrulama betiği (parola akışı)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
