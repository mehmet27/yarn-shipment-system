# Üretim ayarları. install.sh bu dosyayı yoksa .env olarak oluşturur ve boş sırları kendisi üretir.
# deploy/prod/.env git'e girmez (SEC-14).

# --- Adres: DNS'te sunucunun IP'sine (A kaydı) yönlenmiş olmalı ---
APP_HOST=app.ornek.com.tr
# Let's Encrypt sertifika bildirimleri için e-posta
ACME_EMAIL=yonetici@ornek.com.tr

# --- İlk yönetici: `admin` hesabı ilk açılışta bu şifreyle oluşur (en az 8 karakter); ilk girişte şifre değiştirilir ---
INITIAL_ADMIN_PASSWORD=
# Yalnızca unutulan admin şifresini sıfırlamak için true yapın, işlem bitince silin (DEPLOY.md "Admin şifresini sıfırlama")
# RESET_ADMIN_PASSWORD=false

# --- Sırlar: boş bırakırsanız install.sh rastgele üretir ---
POSTGRES_PASSWORD=
DB_PASSWORD=
# Kanıt dosyası yükleme/indirme adreslerini imzalayan anahtar; değiştirilirse açık adresler geçersiz olur
EVIDENCE_STORAGE_SIGNING_KEY=
