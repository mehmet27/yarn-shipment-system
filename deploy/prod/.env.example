# Üretim ayarları. install.sh bu dosyayı yoksa .env olarak oluşturur ve boş sırları kendisi üretir.
# deploy/prod/.env git'e girmez (SEC-14).

# --- Adresler: üçü de DNS'te sunucunun IP'sine (A kaydı) yönlenmiş olmalı ---
APP_HOST=app.ornek.com.tr
AUTH_HOST=giris.ornek.com.tr
FILES_HOST=dosya.ornek.com.tr
# Let's Encrypt sertifika bildirimleri için e-posta
ACME_EMAIL=yonetici@ornek.com.tr

# --- İlk yönetici (Keycloak'a ilk açılışta yazılır; ilk girişte şifre ve OTP kurulumu istenir) ---
INITIAL_ADMIN_EMAIL=yonetici@ornek.com.tr
INITIAL_ADMIN_PASSWORD=

# --- Sırlar: boş bırakırsanız install.sh rastgele üretir ---
POSTGRES_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
GATEWAY_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
EVIDENCE_STORAGE_ACCESS_KEY=
EVIDENCE_STORAGE_SECRET_KEY=
