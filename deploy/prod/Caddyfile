# TLS sertifikasını Caddy kendiliğinden alır ve yeniler (Let's Encrypt). 80 ve 443 numaralı portlar dışarıya açık olmalıdır.
{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	encode zstd gzip
	# Tarayıcı bu adrese bir yıl boyunca yalnızca HTTPS ile gelir (ilk istekte araya girip HTTP'ye düşürme saldırısına karşı).
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:80
}
