{
  "name": "iplik-sevkiyat-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @iplik/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@iplik/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
